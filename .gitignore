############################
# Node / JS common ignores #
############################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnpm-debug.log*

#####################
# Build artifacts   #
#####################
dist/
build/
.next/
.nuxt/
.turbo/
.parcel-cache/
.cache/
coverage/

#####################
# Environment files #
#####################
.env
.env.*
client/.env
server/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

#####################
# IDE/system files  #
#####################
.DS_Store
Thumbs.db
.vscode/
.idea/

#####################
# Logs & misc       #
#####################
*.log
*.pid
*.seed
*.pid.lock

########################################
# Public large binaries (do not commit)#
########################################
client/public/*.exe
client/public/*.msi
client/public/*.dmg
client/public/*.pkg
client/public/*.zip
client/public/*.7z
client/public/*.tar
client/public/*.gz
client/public/*.iso
client/public/*.mp4
client/public/*.mov
client/public/*.avi

########################################
# Monorepo subfolders (if any)         #
########################################
client/node_modules/
server/node_modules/


